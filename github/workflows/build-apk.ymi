name: Build GKS Hymn Book APK

# Produces an installable, signed release APK you can download from the run's
# "Artifacts" section. Runs on every push and can be started manually.
on:
  push:
    branches: [ main, master ]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Set up Android SDK
        uses: android-actions/setup-android@v3

      - name: Create a signing keystore
        run: |
          # A self-signed keystore is generated so the APK is signed and
          # installable. To publish UPDATES that upgrade in place, replace this
          # step with your own committed keystore (see README) so the signature
          # stays stable across versions.
          keytool -genkeypair -v \
            -keystore "$RUNNER_TEMP/gks.jks" \
            -storepass gkspass -keypass gkspass \
            -alias gks -keyalg RSA -keysize 2048 -validity 10000 \
            -dname "CN=GKS Hymn Book, O=God's Kingdom Society, C=NG"

      - name: Build signed release APK
        env:
          GKS_KEYSTORE: ${{ runner.temp }}/gks.jks
          GKS_STORE_PASSWORD: gkspass
          GKS_KEY_ALIAS: gks
          GKS_KEY_PASSWORD: gkspass
        run: |
          chmod +x ./gradlew
          ./gradlew :app:assembleRelease --no-daemon

      - name: Upload APK artifact
        uses: actions/upload-artifact@v4
        with:
          name: gks-hymn-book-release-apk
          path: app/build/outputs/apk/release/*.apk
          if-no-files-found: error
